{
  "slug": "classic",
  "title": "Classic",
  "version": "1.0.0",
  "author": "UnysonPlus",
  "base": "default",
  "description": "The modern structure at WordPress density: system fonts, 13px text, tight corners and the core blue. The escape hatch for anyone who wants the new layout without the new look.",
  "fonts": {
    "ui": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
    "mono": "Consolas, Monaco, monospace",
    "files": []
  },
  "shape": { "radius-sm": "2px", "radius": "3px", "radius-lg": "4px", "radius-pill": "999px" },
  "density": { "font-size": "13px", "line-height": "1.45", "control-h": "32px", "row-h": "44px", "sidebar-w": "220px", "bar-h": "44px", "tracking": "0" },
  "tokens": {
    "light": {
      "bg": "#f0f0f1", "bg2": "#ffffff", "panel": "#ffffff", "panel2": "#f6f7f7", "hover": "#eef1f4",
      "border": "#dcdcde", "border2": "#c3c4c7",
      "text": "#1d2327", "text2": "#50575e", "text3": "#646970",
      "accent": "#2271b1", "accent2": "#3582c4", "accent-fg": "#ffffff",
      "green": "#00a32a", "amber": "#996800", "red": "#d63638", "blue": "#2271b1", "pink": "#b32d6e"
    },
    "dark": {
      "bg": "#1d2327", "bg2": "#23282d", "panel": "#2c3338", "panel2": "#32373c", "hover": "#3c434a",
      "border": "#3c434a", "border2": "#50575e",
      "text": "#f0f0f1", "text2": "#c3c4c7", "text3": "#a7aaad",
      "accent": "#72aee6", "accent2": "#9ec2e6", "accent-fg": "#0a2a45",
      "green": "#68de7c", "amber": "#f0c33c", "red": "#ff8085", "blue": "#72aee6", "pink": "#e58fb8"
    }
  },
  "wp_color_scheme": {
    "light": ["#f0f0f1", "#ffffff", "#2271b1", "#3582c4"],
    "dark": ["#1d2327", "#2c3338", "#72aee6", "#9ec2e6"]
  }
}
